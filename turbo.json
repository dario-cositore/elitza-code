{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml",
    "package.json"
  ],
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "@elitza/cli#typecheck": {
      "dependsOn": ["@elitza/core#typecheck"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@elitza/sdk#typecheck": {
      "dependsOn": ["@elitza/core#typecheck"]
    },
    "@elitza/server#typecheck": {
      "dependsOn": ["@elitza/core#typecheck"]
    },
    "@elitza/simulation#typecheck": {
      "dependsOn": ["@elitza/core#typecheck"]
    },
    "@elitza/tui#typecheck": {
      "dependsOn": ["@elitza/core#typecheck"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    // Workspace packages export their sources, so tests never wait for a dependency's build; the build job in
    // test.yml checks the library builds. No package has a transit script: it runs nothing and only folds every
    // workspace dependency into the test hash.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "@elitza/brain#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/ai#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/codemode#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/core#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/function#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@elitza/httpapi-codegen#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/server#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/cli#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/tui#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/latex#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/app#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/ui#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/session-ui#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/client#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/gui-extensions#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/http-recorder#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/merman#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/plugin#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/plugin-browser#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/script#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/sdk#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/simulation#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/theme#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/util#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@elitza/sdk#verify:package": {
      "outputs": []
    }
  }
}
