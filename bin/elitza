#!/usr/bin/env bash
# Elitza launcher
#
# Locates the package root, resolves ELITZA_HOME and the virtualenv, then
# starts either the Rust TUI (default) or the Python agent (--python).
#
# Works from three layouts without any configuration:
#   1. curl install   ~/.elitza/agent/bin/elitza   -> home = ~/.elitza
#   2. dev checkout   <repo>/bin/elitza            -> home = <repo> (if repo
#                                                     is not named "agent")
#   3. dev package    <pkg>/bin/elitza (shim)      -> home = <pkg>
#
# readlink -f resolves symlinks, so this also works when invoked through a
# link on PATH (e.g. ~/.local/bin/elitza -> ~/.elitza/agent/bin/elitza).

set -e

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PKG_ROOT="$(dirname "$SELF_DIR")"   # repository root (holds pyproject.toml)

# --- ELITZA_HOME -----------------------------------------------------------
# Explicit override always wins. Otherwise a checkout named "agent" lives one
# level below the home directory (the ~/.elitza/agent convention), so the home
# is its parent; in any other layout the repository root *is* the home.
if [[ -n "${ELITZA_HOME:-}" ]]; then
    :
elif [[ "$(basename "$PKG_ROOT")" == "agent" ]]; then
    ELITZA_HOME="$(dirname "$PKG_ROOT")"
else
    ELITZA_HOME="$PKG_ROOT"
fi
export ELITZA_HOME

# --- virtualenv ------------------------------------------------------------
if [[ -x "$PKG_ROOT/venv/bin/python" ]]; then
    VENV_PY="$PKG_ROOT/venv/bin/python"
elif [[ -x "$ELITZA_HOME/agent/venv/bin/python" ]]; then
    VENV_PY="$ELITZA_HOME/agent/venv/bin/python"
else
    echo "elitza: no virtualenv found (looked in $PKG_ROOT/venv and" \
         "$ELITZA_HOME/agent/venv)" >&2
    echo "elitza: run the installer, or create one with:" >&2
    echo "  uv venv $PKG_ROOT/venv --python 3.11 && $PKG_ROOT/venv/bin/python -m pip install -e $PKG_ROOT" >&2
    exit 1
fi
export ELITZA_PYTHON="$VENV_PY"

BIN_DIR="$ELITZA_HOME/bin"
export PATH="$BIN_DIR:$PATH"

# --- --python: run the pure-Python agent (Rich / Textual) -------------------
if [[ "${1:-}" == "--python" || "${1:-}" == "-p" ]]; then
    shift
    exec "$VENV_PY" -m elitza "$@"
fi

# --- --version / --help: never touch the TUI --------------------------------
# The Rust TUI does not parse these (it would ignore them and start the full
# interface), and reaching it could trigger the build-on-demand path below.
# Handling them here keeps them working -- and instant -- even on a machine
# with no TUI binary and no Rust toolchain.
if [[ "${1:-}" == "--version" || "${1:-}" == "-V" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    exec "$VENV_PY" -m elitza "$@"
fi

# --- default: the Rust TUI -------------------------------------------------
# Order of preference:
#   1. bin/elitza-tui next to this launcher -- the prebuilt binary shipped in
#      a release archive. This is what makes a curl install work with no Rust.
#   2. $ELITZA_HOME/bin/elitza-tui -- where a local build or the dev package
#      layout puts it.
#   3. a cargo build in tui/target, then building on demand.
TUI_BIN=""
for candidate in "$PKG_ROOT/bin/elitza-tui" "$BIN_DIR/elitza-tui" \
                 "$PKG_ROOT/tui/target/release/elitza-tui"; do
    if [[ -x "$candidate" ]]; then
        TUI_BIN="$candidate"
        break
    fi
done

if [[ -z "$TUI_BIN" ]]; then
    TUI_BIN="$BIN_DIR/elitza-tui"
fi

if [[ -x "$TUI_BIN" ]]; then
    exec "$TUI_BIN" "$@"
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "elitza: the TUI binary is missing and cargo is not installed." >&2
    echo "elitza: install Rust (https://rustup.rs) or run the Python agent:" >&2
    echo "  $SELF_DIR --python" >&2
    exit 1
fi

echo "elitza: building the TUI (first run only)..." >&2
mkdir -p "$BIN_DIR"
(cd "$PKG_ROOT/tui" && cargo build --release -q)
cp "$PKG_ROOT/tui/target/release/elitza-tui" "$TUI_BIN"
exec "$TUI_BIN" "$@"
